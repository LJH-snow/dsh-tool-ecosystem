{
  "name": "@libai168/dsh-tool-google-calendar",
  "description": "Google Calendar read-only tools for DeepSeek Harness: calendars, events, and bounded search",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "auth:calendar": "node scripts/auth-calendar.mjs",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "awesome-dsh-plugin",
    "cordis",
    "google-calendar",
    "google",
    "calendar",
    "events",
    "agenda",
    "search",
    "read-only",
    "agent",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LJH-snow/dsh-tool-google-calendar.git"
  },
  "homepage": "https://github.com/LJH-snow/dsh-tool-google-calendar#readme",
  "bin": {
    "dsh-google-calendar-auth": "./scripts/auth-calendar.mjs"
  }
}
